# Node
node_modules/
npm-debug.log*

# Render intermediates — frame sequences are large and fully reproducible
# from source via video/*/src/build.sh. Built masters in dist/ are committed
# so the deliverable is available without a rebuild.
video/*/build/
*.tmp

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Explainer render intermediates
video/explainer/build/

# Build transcripts. Same reasoning as build/ — regenerated by every run of
# video/*/src/build.sh, and never an input to one.
video/*/build.log
